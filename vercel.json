{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "api/index.ts"
    }
  },
  "crons": [
    {
      "path": "/api/queue/process",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "backend",
        "path": "/api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend",
        "path": "/api/$1"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "backend",
        "path": "/api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "backend",
        "path": "/$1"
      }
    }
  ]
}
